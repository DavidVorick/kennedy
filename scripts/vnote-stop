#!/usr/bin/env bash

VNOTE_DIR="/home/user/media/vnotes"
AUDIO_API="http://127.0.0.1:4325/api/v1/audio-ingress"

sleep 1
pkill -x arecord
sleep 1

# Look only at the five most recently modified vnotes.
mapfile -t recent_vnotes < <(
    ls -1t "$VNOTE_DIR"/*-vnote.wav 2>/dev/null | head -n 5
)

for vnote in "${recent_vnotes[@]}"; do
    sha256="$(sha256sum "$vnote" | cut -d' ' -f1)"
    status="$(curl --silent --output /dev/null --write-out '%{http_code}' \
        "$AUDIO_API/by-sha256/$sha256")"

    # A 200 means Kennedy already has this exact file.
    if [[ "$status" == "200" ]]; then
        continue
    fi

    if [[ "$status" != "404" ]]; then
        exit 1
    fi

    filename="$(basename "$vnote")"
    recorded_epoch="${filename%-vnote.wav}"
    recorded_epoch="${recorded_epoch##*-}"
    recorded_at="$(date --iso-8601=seconds --date="@$recorded_epoch")"

    curl --silent --show-error --fail \
        --form "recorded_at=$recorded_at" \
        --form "file=@$vnote;type=audio/wav" \
        "$AUDIO_API" >/dev/null || exit 1
done
