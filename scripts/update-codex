#!/usr/bin/env bash

set -euo pipefail

PROGRAM="${0##*/}"

die() {
    printf '%s: %s\n' "$PROGRAM" "$*" >&2
    exit 1
}

usage() {
    cat <<EOF
Usage: $PROGRAM [CONTAINER]

Update the Podman image used by codex-safe to the latest stable Codex CLI.
Run this script on the host, while a Codex container is active.

Environment overrides:
  CODEX_CONTAINER     Codex container to inspect instead of auto-detecting one
  CODEX_IMAGE         Source image to update; skips container detection
  CODEX_TARGET_IMAGE  Image tag to replace (defaults to the source image tag)
EOF
}

if (( $# > 1 )); then
    usage >&2
    exit 2
fi
if [[ "${1-}" == "-h" || "${1-}" == "--help" ]]; then
    usage
    exit 0
fi

command -v podman >/dev/null 2>&1 ||
    die "podman is not installed; run this script on the host, not inside the Codex container"

container="${CODEX_CONTAINER:-${1-}}"
source_image="${CODEX_IMAGE:-}"

if [[ -z "$source_image" ]]; then
    if [[ -z "$container" ]]; then
        candidates=()
        while IFS= read -r candidate; do
            [[ -n "$candidate" ]] || continue
            if podman exec "$candidate" sh -c \
                'command -v codex >/dev/null 2>&1 && command -v npm >/dev/null 2>&1' \
                2>/dev/null
            then
                candidates+=("$candidate")
            fi
        done < <(podman ps --format '{{.Names}}')

        case "${#candidates[@]}" in
            0)
                die "no active Codex container found; start codex-safe in another terminal or set CODEX_IMAGE"
                ;;
            1)
                container="${candidates[0]}"
                ;;
            *)
                printf '%s: multiple active Codex containers found:\n' "$PROGRAM" >&2
                printf '  %s\n' "${candidates[@]}" >&2
                die "pass the intended container name as the first argument"
                ;;
        esac
    fi

    podman container exists "$container" ||
        die "container does not exist: $container"

    source_image="$(podman container inspect --format '{{.ImageName}}' "$container")"
    [[ -n "$source_image" ]] ||
        die "could not determine the image used by container $container"
fi

image_id="$(podman image inspect --format '{{.Id}}' "$source_image")" ||
    die "could not inspect image: $source_image"
image_user="$(podman image inspect --format '{{.Config.User}}' "$image_id")" ||
    die "could not determine the image user"
image_user="${image_user:-0}"

if [[ ! "$image_user" =~ ^[a-zA-Z0-9_.:-]+$ ]]; then
    die "image has an unsupported user value: $image_user"
fi

target_image="${CODEX_TARGET_IMAGE:-$source_image}"
if [[ "$target_image" == "$image_id" || "$target_image" == sha256:* ]]; then
    die "the source image is untagged; set CODEX_TARGET_IMAGE to the image tag used by codex-safe"
fi
if [[ ! "$source_image" =~ ^[a-zA-Z0-9._/@:+-]+$ ]]; then
    die "source image has an unsupported name: $source_image"
fi
if [[ ! "$target_image" =~ ^[a-zA-Z0-9._/:+-]+$ ]]; then
    die "target image has an unsupported tag: $target_image"
fi

current_output="$(
    podman run --rm --entrypoint codex "$image_id" --version
)" || die "could not run Codex from image $source_image"
current_version="${current_output##* }"

latest_version="$(
    podman run --rm --entrypoint npm "$image_id" \
        view @openai/codex version --silent
)" || die "could not query the latest Codex version from npm"
latest_version="${latest_version//$'\r'/}"
latest_version="${latest_version//$'\n'/}"

[[ "$latest_version" =~ ^[0-9]+([.][0-9]+){2}([+-][0-9A-Za-z.-]+)?$ ]] ||
    die "npm returned an unexpected version: $latest_version"

if [[ "$current_version" == "$latest_version" ]]; then
    printf 'Codex is already current: %s (%s)\n' "$current_version" "$target_image"
    exit 0
fi

build_dir="$(mktemp -d)" ||
    die "could not create a temporary build directory"
trap 'rm -rf -- "$build_dir"' EXIT

{
    printf 'FROM %s\n' "$source_image"
    printf 'USER 0\n'
    printf 'RUN npm install --global "@openai/codex@%s" && codex --version\n' \
        "$latest_version"
    printf 'USER %s\n' "$image_user"
} >"$build_dir/Containerfile"

printf 'Updating %s from Codex %s to %s...\n' \
    "$target_image" "$current_version" "$latest_version"
podman build \
    --no-cache \
    --tag "$target_image" \
    --file "$build_dir/Containerfile" \
    "$build_dir"

installed_output="$(
    podman run --rm --entrypoint codex "$target_image" --version
)" || die "the updated image failed verification"
installed_version="${installed_output##* }"

[[ "$installed_version" == "$latest_version" ]] ||
    die "expected Codex $latest_version after the update, found $installed_version"

printf 'Updated %s to Codex %s.\n' "$target_image" "$installed_version"
printf 'Exit the current Codex session and run codex-safe again to use it.\n'
