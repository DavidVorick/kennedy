#!/usr/bin/env bash

set -u
set -o pipefail

AUDIO_API="${KENNEDY_AUDIO_API:-http://127.0.0.1:4321/api/v1/audio-ingress}"
AUDIO_API="${AUDIO_API%/}"
VNOTE_LIMIT=5
VNOTE_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
CHECKSUM_CACHE="$VNOTE_DIR/.vnote-ingress-sha256-cache-v1"
STABILITY_SECONDS=2
response_file=""
fix_temp=""

die() {
    printf 'vnote-ingress: %s\n' "$*" >&2
    exit 1
}

usage() {
    printf 'Usage: %s [--fix FILE]\n' "$(basename -- "$0")"
}

cleanup() {
    [[ -z "$response_file" ]] || rm -f -- "$response_file"
    [[ -z "$fix_temp" ]] || rm -f -- "$fix_temp"
}

recorded_epoch() {
    local vnote="$1"
    local filename

    filename="$(basename -- "$vnote")"
    if [[ "$filename" =~ -([0-9]{10,})-vnote\.wav$ ]]; then
        printf '%s\n' "${BASH_REMATCH[1]}"
    else
        stat --format='%Y' -- "$vnote"
    fi
}

file_signature() {
    stat --format='%s:%y' -- "$1"
}

checksum_signature() {
    # Device, inode, size, mtime, and ctime let unchanged files reuse a digest.
    # Nanosecond timestamps keep same-size rapid rewrites from looking unchanged.
    stat --format='%d:%i:%s:%y:%z' -- "$1"
}

remember_checksum() {
    local signature="$1"
    local sha256="$2"

    if [[ -L "$CHECKSUM_CACHE" || ( -e "$CHECKSUM_CACHE" && ! -f "$CHECKSUM_CACHE" ) ]]; then
        die "checksum cache is not a regular file: $CHECKSUM_CACHE"
    fi
    (
        umask 077
        printf '%s\t%s\n' "$signature" "$sha256" >>"$CHECKSUM_CACHE"
    ) || die "could not update checksum cache $CHECKSUM_CACHE"
    cached_sha256s["$signature"]="$sha256"
}

wav_is_finalized() {
    local vnote="$1"
    local size riff_size
    local -a header

    size="$(stat --format='%s' -- "$vnote")" || return 1
    (( size >= 12 )) || return 1
    read -r -a header < <(od -An -tu1 -N12 -- "$vnote") || return 1
    (( ${#header[@]} == 12 )) || return 1
    (( header[0] == 82 && header[1] == 73 && header[2] == 70 && header[3] == 70 )) ||
        return 1
    (( header[8] == 87 && header[9] == 65 && header[10] == 86 && header[11] == 69 )) ||
        return 1
    riff_size=$((header[4] + 256 * header[5] + 65536 * header[6] + 16777216 * header[7]))
    (( riff_size + 8 <= size ))
}

vnote_is_ready() {
    local vnote="$1"
    local before="${initial_signatures[$vnote]-}"
    local after

    [[ -n "$before" ]] || return 1
    after="$(file_signature "$vnote")" || return 1
    [[ "$before" == "$after" ]] || return 1
    wav_is_finalized "$vnote" || return 1
    READY_SIGNATURE="$after"
}

fix_vnote() {
    local vnote="$1"
    local backup
    local vnote_dir

    [[ -f "$vnote" && ! -L "$vnote" ]] ||
        die "file is not a regular file: $vnote"

    for dependency in od stat; do
        command -v "$dependency" >/dev/null 2>&1 ||
            die "required command not found: $dependency"
    done

    if wav_is_finalized "$vnote"; then
        printf 'Already finalized; no changes made: %s\n' "$vnote"
        return
    fi

    backup="${vnote}.unfinalized"
    [[ ! -e "$backup" && ! -L "$backup" ]] ||
        die "refusing to overwrite existing recovery backup: $backup"

    for dependency in ffmpeg chmod mktemp mv touch; do
        command -v "$dependency" >/dev/null 2>&1 ||
            die "required command not found: $dependency"
    done

    vnote_dir="$(cd -- "$(dirname -- "$vnote")" && pwd -P)" ||
        die "could not inspect the directory containing $vnote"
    fix_temp="$(mktemp --tmpdir="$vnote_dir" '.vnote-fix.XXXXXXXXXX.wav')" ||
        die "could not create a temporary recovery file beside $vnote"

    if ! ffmpeg -nostdin -hide_banner -loglevel warning \
        -ignore_length 1 \
        -i "$vnote" \
        -map 0:a:0 \
        -c:a pcm_s16le \
        -f wav \
        -y "$fix_temp"; then
        die "ffmpeg could not recover $vnote; the original was not changed"
    fi
    wav_is_finalized "$fix_temp" ||
        die "ffmpeg did not produce a finalized WAV; the original was not changed"
    chmod --reference="$vnote" -- "$fix_temp" ||
        die "could not preserve permissions while fixing $vnote"
    touch --reference="$vnote" -- "$fix_temp" ||
        die "could not preserve timestamps while fixing $vnote"

    mv -- "$vnote" "$backup" ||
        die "could not preserve the unfinalized recording at $backup"
    if ! mv -- "$fix_temp" "$vnote"; then
        if mv -- "$backup" "$vnote"; then
            die "could not install the recovered WAV; the original was restored"
        fi
        die "could not install the recovered WAV; the original remains at $backup"
    fi
    fix_temp=""

    printf 'Fixed: %s\nOriginal retained at: %s\n' "$vnote" "$backup"
}

trap cleanup EXIT

case "$#" in
    0)
        ;;
    1)
        case "$1" in
            -h|--help)
                usage
                exit 0
                ;;
            --fix)
                die "--fix requires a file"
                ;;
            *)
                die "unknown argument: $1"
                ;;
        esac
        ;;
    2)
        [[ "$1" == "--fix" ]] || die "unknown argument: $1"
        fix_vnote "$2"
        exit 0
        ;;
    *)
        die "expected no arguments or --fix FILE"
        ;;
esac

for dependency in curl sha256sum date find od sort stat; do
    command -v "$dependency" >/dev/null 2>&1 ||
        die "required command not found: $dependency"
done

candidate_count=0
ready_count=0
uploaded_count=0

declare -A cached_sha256s=()
if [[ -L "$CHECKSUM_CACHE" || ( -e "$CHECKSUM_CACHE" && ! -f "$CHECKSUM_CACHE" ) ]]; then
    die "checksum cache is not a regular file: $CHECKSUM_CACHE"
elif [[ -f "$CHECKSUM_CACHE" ]]; then
    while IFS=$'\t' read -r cached_signature cached_sha256 extra; do
        if [[ -z "$extra" && -n "$cached_signature" &&
            "$cached_sha256" =~ ^[0-9a-f]{64}$ ]]; then
            cached_sha256s["$cached_signature"]="$cached_sha256"
        fi
    done <"$CHECKSUM_CACHE"
fi

declare -A initial_signatures=()
while IFS= read -r -d '' vnote; do
    initial_signatures["$vnote"]="$(file_signature "$vnote")" ||
        die "could not inspect $vnote"
done < <(
    find "$VNOTE_DIR" -maxdepth 1 -type f -name '*-vnote.wav' -print0
)
if (( ${#initial_signatures[@]} > 0 )); then
    sleep "$STABILITY_SECONDS"
fi

while IFS=$'\t' read -r -d '' epoch vnote; do
    candidate_count=$((candidate_count + 1))

    READY_SIGNATURE=""
    if ! vnote_is_ready "$vnote"; then
        printf 'Not finalized or still changing: %s\n' "$(basename -- "$vnote")"
        continue
    fi
    ready_count=$((ready_count + 1))

    CHECKSUM_SIGNATURE="$(checksum_signature "$vnote")" ||
        die "could not inspect $vnote"
    sha256="${cached_sha256s[$CHECKSUM_SIGNATURE]-}"
    checksum_was_cached=1
    if [[ -z "$sha256" ]]; then
        checksum_was_cached=0
        sha256="$(sha256sum -- "$vnote")" ||
            die "could not hash $vnote"
        sha256="${sha256%% *}"
    fi
    if [[ "$(file_signature "$vnote")" != "$READY_SIGNATURE" ||
        "$(checksum_signature "$vnote")" != "$CHECKSUM_SIGNATURE" ]]; then
        ready_count=$((ready_count - 1))
        printf 'Changed while checking; skipped: %s\n' "$(basename -- "$vnote")"
        continue
    fi
    if (( ! checksum_was_cached )); then
        remember_checksum "$CHECKSUM_SIGNATURE" "$sha256"
    fi

    if ! status="$(
        curl --silent --show-error \
            --connect-timeout 5 \
            --output /dev/null \
            --write-out '%{http_code}' \
            "$AUDIO_API/by-sha256/$sha256"
    )"; then
        die "could not reach Kennedy at $AUDIO_API"
    fi

    case "$status" in
        200)
            printf 'Already known: %s\n' "$(basename -- "$vnote")"
            continue
            ;;
        404)
            ;;
        *)
            die "Kennedy returned HTTP $status while checking $(basename -- "$vnote")"
            ;;
    esac

    if ! recorded_at="$(date --utc --iso-8601=seconds --date="@$epoch")"; then
        die "could not determine the recording time for $vnote"
    fi

    response_file="$(mktemp)" ||
        die "could not create a temporary response file"
    if ! upload_status="$(
        curl --silent --show-error \
            --connect-timeout 5 \
            --output "$response_file" \
            --write-out '%{http_code}' \
            --form-string "recorded_at=$recorded_at" \
            --form "file=@$vnote;type=audio/wav" \
            "$AUDIO_API"
    )"; then
        die "upload failed for $vnote"
    fi

    case "$upload_status" in
        200|202)
            rm -f -- "$response_file"
            response_file=""
            uploaded_count=$((uploaded_count + 1))
            printf 'Queued: %s (%s)\n' "$(basename -- "$vnote")" "$recorded_at"
            ;;
        *)
            printf 'vnote-ingress: Kennedy returned HTTP %s while uploading %s\n' \
                "$upload_status" "$(basename -- "$vnote")" >&2
            if [[ -s "$response_file" ]]; then
                printf 'vnote-ingress: response: ' >&2
                tr '\n' ' ' <"$response_file" >&2
                printf '\n' >&2
            fi
            exit 1
            ;;
    esac

    if (( uploaded_count == VNOTE_LIMIT )); then
        break
    fi
done < <(
    while IFS= read -r -d '' vnote; do
        epoch="$(recorded_epoch "$vnote")" || exit 1
        printf '%s\t%s\0' "$epoch" "$vnote"
    done < <(
        find "$VNOTE_DIR" -maxdepth 1 -type f -name '*-vnote.wav' -print0
    ) |
        sort --zero-terminated --field-separator=$'\t' \
            --key=1,1nr --key=2,2
)

if (( candidate_count == 0 )); then
    printf 'No *-vnote.wav files found in %s\n' "$VNOTE_DIR"
elif (( uploaded_count == 0 )); then
    if (( ready_count == 0 )); then
        printf 'Nothing to upload; no finalized, stable vnotes were found in %s\n' "$VNOTE_DIR"
    else
        printf 'Nothing to upload; Kennedy already knows every finalized vnote in %s\n' "$VNOTE_DIR"
    fi
else
    printf 'Queued %d vnote%s for Kennedy ingress.\n' \
        "$uploaded_count" "$([[ "$uploaded_count" == 1 ]] && printf '' || printf 's')"
fi
